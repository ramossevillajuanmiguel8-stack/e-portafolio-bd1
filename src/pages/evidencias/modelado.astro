---
import Page from '../../layouts/Page.astro';
const diagramUrl = `${import.meta.env.BASE_URL}evidencias/modelado/modelo_ER_CineAndes.png`;
const sourceUrl = `${import.meta.env.BASE_URL}evidencias/modelado/modelo_ER_CineAndes.drawio`;
---

<Page title="Modelado" description="Diagrama entidad-relación de CineAndes">
  <article class="modelado">
    <h1>Modelo entidad-relación: CineAndes</h1>
    <p>
      Esta evidencia presenta el diagrama entidad-relación elaborado para el caso CineAndes, con
      entidades, atributos y relaciones del sistema.
    </p>
    <figure>
      <a
        href={diagramUrl}
        target="_blank"
        rel="noopener"
        aria-label="Abrir el diagrama en tamaño completo"
      >
        <img src={diagramUrl} alt="Diagrama entidad-relación de CineAndes" loading="lazy" />
      </a>
      <figcaption>
        Diagrama entidad-relación de CineAndes. Selecciona la imagen para abrirla en tamaño
        completo.
      </figcaption>
    </figure>
    <p>
      <a class="file-link" href={sourceUrl} target="_blank" rel="noopener"
        >Abrir o descargar el archivo editable de Draw.io</a
      >
    </p>
  </article>
</Page>

<style>
  .modelado {
    max-width: 100%;
    line-height: 1.7;
  }
  .modelado figure {
    margin: 1.5rem 0;
  }
  .modelado img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid #d1d5db;
    border-radius: 0.75rem;
    background: white;
  }
  .modelado figcaption {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    opacity: 0.8;
  }
  .modelado .file-link {
    display: inline-block;
    padding: 0.7rem 1rem;
    border: 1px solid currentColor;
    border-radius: 0.5rem;
    text-decoration: none;
    font-weight: 600;
  }
</style>
